<UserControl x:Class="HSCompsPlugin.UI.CardTooltipControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HSCompsPlugin.UI"
             mc:Ignorable="d" 
             IsHitTestVisible="False"
             Focusable="False"
             Background="Transparent">

    <UserControl.Resources>
        <local:CardNormalImageConverter x:Key="NormalImageConverter"/>
        <local:CardGoldenImageConverter x:Key="GoldenImageConverter"/>
    </UserControl.Resources>

    <Grid IsHitTestVisible="False" Background="Transparent" Margin="14">
        <!-- Горизонтальный ряд: увеличенная обычная карта слева и золотая версия справа -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Обычная версия карты с мягкой теплой подсветкой -->
            <Image x:Name="ImgCardNormal"
                   Source="{Binding Self, Converter={StaticResource NormalImageConverter}}" 
                   Width="328" Height="489" 
                   Stretch="Uniform" 
                   Margin="8,0"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect Color="#FFB800" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                </Image.Effect>
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

            <!-- Золотая версия карты с мягкой теплой подсветкой -->
            <Image x:Name="ImgCardGolden"
                   Source="{Binding Self, Converter={StaticResource GoldenImageConverter}}" 
                   Width="328" Height="489" 
                   Stretch="Uniform" 
                   Margin="8,0"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <DropShadowEffect Color="#FFB800" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                </Image.Effect>
                <Image.Style>
                    <Style TargetType="Image">
                        <Style.Triggers>
                            <Trigger Property="Source" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

        </StackPanel>
    </Grid>
</UserControl>
