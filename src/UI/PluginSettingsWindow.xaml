<Window x:Class="HSCompsPlugin.UI.PluginSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d"
        Title="Настройки — HS Comps (Поля сражений)" 
        Width="670" Height="830"
        MinWidth="620" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Background="#18110D">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8C0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3D2614"/>
            <Setter Property="Foreground" Value="#FFE8B0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderBrush" Value="#8B6534"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5C3B1E"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#F5C06A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#29180C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#6B4822" BorderThickness="2" Margin="10" Padding="18" Background="#241710" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="HS COMPS — НАСТРОЙКИ ПЛАГИНА" 
                           Foreground="#FFD982" FontSize="20" FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Конфигурация отображения мини-HUD и управление базой данных" 
                           Foreground="#A8907A" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                <Separator Background="#573A1E" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- 2. Основное содержимое со скроллером -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <StackPanel Margin="0,2,0,10">

                    <!-- СЕКЦИЯ 1: ОТОБРАЖЕНИЕ И ОВЕРЛЕЙ -->
                    <Border Background="#1C130D" BorderBrush="#50351A" BorderThickness="1.2" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ПАРАМЕТРЫ МИНИ-HUD И ОВЕРЛЕЯ" 
                                       Foreground="#FFDF78" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>

                            <CheckBox x:Name="ChkShowInBattlegrounds" 
                                      Content="Включить мини-HUD по умолчанию в матчах Полей сражений"
                                      IsChecked="True"/>

                            <CheckBox x:Name="ChkShowSelectionStatsOverlay" 
                                      Content="Показывать плашки статистики (Тир, Выбор %, Победы %) при выборе Героя и Тринкетов"
                                      IsChecked="True"/>

                            <TextBlock Text="* Компактные плашки появляются строго под картами на муллигане героев и на 6/9 ходах при выборе тринкетов."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,8"/>
                            
                            <CheckBox x:Name="ChkShowInMainMenu" 
                                      Content="Отображать мини-HUD в главном меню игры"/>

                            <TextBlock Text="* При включении в главном меню мини-HUD показывает топовые мета-столы для ознакомления."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,8"/>

                            <CheckBox x:Name="ChkDontHideMiniOverlayOnDetails" 
                                      Content="Не скрывать мини-HUD при открытии подробного окна"/>

                            <TextBlock Text="* Мини-HUD останется на экране одновременно с большим окном анализа столов."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,8"/>

                            <CheckBox x:Name="ChkAutoHideDetailsInCombat" 
                                      Content="Автоматически сворачивать окно анализа при начале фазы боя"/>

                            <TextBlock Text="* Если подробное окно открыто в конце вербовки, оно само свернется с началом боя."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,8"/>

                            <CheckBox x:Name="ChkHighPerformanceMode" 
                                      Content="Режим максимальной производительности (для слабых ПК / ноутбуков)"/>

                            <TextBlock Text="* Оптимизирует графические эффекты и снижает нагрузку на видеокарту / процессор."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,12"/>

                            <Separator Background="#3E2713" Margin="0,0,0,10"/>

                            <TextBlock Text="Положение и управление масштабом:" Foreground="#E3B362" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>

                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Общий масштаб плагина:" 
                                           Foreground="#FFE8C0" FontSize="13" FontWeight="SemiBold" 
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="SliderOverlayScale" Grid.Column="1" 
                                        Minimum="50" Maximum="150" Value="100" 
                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                                        VerticalAlignment="Center" Cursor="Hand"
                                        ValueChanged="OnScaleSliderValueChanged"/>
                                <TextBlock x:Name="TxtScalePercent" Grid.Column="2" Text="100%" 
                                           Foreground="#FFD982" FontSize="13.5" FontWeight="Bold" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Сбросить позицию (центр)" Click="OnResetPositionClick" Margin="0,0,8,6" Padding="10,6" FontSize="12"/>
                                <Button Content="Сбросить масштаб (100%)" Click="OnResetScaleClick" Margin="0,0,8,6" Padding="10,6" FontSize="12"/>
                                <Button x:Name="BtnClearImageCache" Content="🧹 Очистить кэш артов" Click="OnClearImageCacheClick" Margin="0,0,8,6" Padding="10,6" FontSize="12"/>
                                <Button Content="📊 Открыть окно анализа столов" 
                                        Click="OnOpenDetailsClick" 
                                        Background="#263812" BorderBrush="#4D7A2A" Foreground="#C6EE88"
                                        Margin="0,0,0,6" Padding="12,6" FontSize="12"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- СЕКЦИЯ 2: БАЗА ДАННЫХ МЕТА-СТОЛОВ (FIRESTONE API) -->
                    <Border Background="#1C130D" BorderBrush="#50351A" BorderThickness="1.2" CornerRadius="6" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="БАЗА ДАННЫХ МЕТА-СТОЛОВ (FIRESTONE API)" 
                                       Foreground="#FFDF78" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>

                            <!-- Карточка состояния базы -->
                            <Border Background="#140C08" BorderBrush="#3D2614" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка базы данных -->
                                    <Border Grid.Column="0" Background="#29180C" BorderBrush="#7C5020" BorderThickness="1.5" 
                                            CornerRadius="6" Width="40" Height="40" Margin="0,0,12,0" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z" 
                                              Fill="#E5A642" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtDbStatusSummary" 
                                                   Text="База данных столов: загрузка..." 
                                                   Foreground="#FFE294" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtDbFileDetails" 
                                                   Text="comps_vector_db.json" 
                                                   Foreground="#9E8772" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtDbStaleWarning" 
                                                   Text="⚠️ База старше 7 дней — рекомендуется обновить мету из Firestone API" 
                                                   Foreground="#FFB84D" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" 
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Кнопка запуска обновления базы из Firestone API -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnUpdateDb" 
                                        Click="OnUpdateDatabaseClick" 
                                        Background="#3E2713" BorderBrush="#E5A642" Foreground="#FFE8B0"
                                        Padding="14,8" FontSize="13" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01,-0.25,1.97,-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12c0,-4.42,-3.58,-8,-8,-8zm0,14c-3.31,0,-6,-2.69,-6,-6c0,-1.01,0.25,-1.97,0.7,-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8v3l4,-4l-4,-4v3z" 
                                              Fill="#F5C06A" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtBtnUpdateDb" Text="Обновить базу из Firestone API" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="BtnToggleLog"
                                        Content="Показать лог"
                                        Click="OnToggleLogClick"
                                        Background="#241710" BorderBrush="#573A1E" Foreground="#CBB49E"
                                        Padding="10,6" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="* Запускает скрипт для скачивания свежих данных и статистики победных столов из открытого API Firestone (ZeroToHeroes), генерирует векторные эмбеддинги и мгновенно обновляет советник в реальном времени."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <!-- Индикатор прогресса -->
                            <ProgressBar x:Name="PbUpdateProgress" Height="5" IsIndeterminate="True" 
                                         Foreground="#FFC95C" Background="#2B1A0E" BorderThickness="0" 
                                         Visibility="Collapsed" Margin="0,4,0,6"/>

                            <!-- Сообщение о статусе обновления -->
                            <TextBlock x:Name="TxtUpdateStatus" 
                                       Text="" 
                                       Foreground="#8AE2FF" FontSize="12" FontWeight="SemiBold" 
                                       Visibility="Collapsed" Margin="0,2,0,6" TextWrapping="Wrap"/>

                            <!-- Лог консоли в реальном времени -->
                            <TextBox x:Name="TxtUpdateLog" 
                                     Height="110" 
                                     Background="#0F0906" BorderBrush="#3D2614" BorderThickness="1"
                                     Foreground="#AEEA7D" FontFamily="Consolas, Lucida Console, Courier New" FontSize="11" 
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" Padding="6"/>
                        </StackPanel>
                    </Border>

                    <!-- СЕКЦИЯ 3: ОБНОВЛЕНИЕ ПЛАГИНА (GITHUB RELEASES) -->
                    <Border Background="#1C130D" BorderBrush="#50351A" BorderThickness="1.2" CornerRadius="6" Padding="14,12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ОБНОВЛЕНИЕ ПЛАГИНА (GITHUB)" 
                                       Foreground="#FFDF78" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>

                            <!-- Карточка состояния версии плагина -->
                            <Border Background="#140C08" BorderBrush="#3D2614" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка обновления -->
                                    <Border Grid.Column="0" Background="#29180C" BorderBrush="#7C5020" BorderThickness="1.5" 
                                            CornerRadius="6" Width="40" Height="40" Margin="0,0,12,0" 
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M19,9h-4V3H9v6H5l7,7 7,-7zM5,18v2h14v-2H5z" 
                                              Fill="#60C8FF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPluginVersionSummary" 
                                                   Text="Текущая версия плагина: v3.2.0 (ZadroTube)" 
                                                   Foreground="#FFE294" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="Авто-апдейтер проверяет свежие релизы на GitHub и обновляет плагин в один клик" 
                                                   Foreground="#9E8772" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Кнопка запуска автономного авто-апдейтера -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnRunUpdater" 
                                        Click="OnRunUpdaterClick" 
                                        Background="#1E334D" BorderBrush="#4A90E2" Foreground="#D4EBFF"
                                        Padding="14,8" FontSize="13" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01,-0.25,1.97,-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12c0,-4.42,-3.58,-8,-8,-8zm0,14c-3.31,0,-6,-2.69,-6,-6c0,-1.01,0.25,-1.97,0.7,-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8v3l4,-4l-4,-4v3z" 
                                              Fill="#60C8FF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="🚀 Проверить обновления / Запустить апдейтер" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="* Запускает утилиту HSCompsUpdater.exe, которая проверяет релизы на GitHub, скачивает архив и обновляет файлы плагина в Hearthstone Deck Tracker."
                                       Foreground="#96806C" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- 3. Кнопки внизу -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Сохранить и закрыть" Click="OnSaveAndCloseClick" Width="175"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
