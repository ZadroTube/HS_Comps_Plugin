<Window x:Class="HSCompsPlugin.UI.CompsDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:HSCompsPlugin.UI"
        mc:Ignorable="d" 
        Title="HS Comps — Мета-советник столов" 
        Width="1040" Height="640"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#01000000"
        Topmost="True"
        ShowActivated="True"
        MouseEnter="OnWindowMouseEnter"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        MouseMove="OnWindowMouseMove"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:CardCropImageConverter x:Key="CropImageConverter"/>
        <local:CardFullImageConverter x:Key="FullImageConverter"/>
        <local:StatusRingConverter x:Key="StatusRingConverter"/>
        <local:OwnedFramedTokenConverter x:Key="OwnedFramedTokenConverter"/>
        <local:PriorityFramedTokenConverter x:Key="PriorityFramedTokenConverter"/>
        <local:BoardShowcaseImageConverter x:Key="BoardShowcaseConverter"/>
        <local:TokenStatsVisibilityConverter x:Key="TokenStatsVisibilityConverter"/>

        <!-- Стиль интерактивной большой карты с ярким золотым сиянием и зумом -->
        <Style x:Key="HearthstoneBoardCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Panel.ZIndex" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" 
                                                 To="1.22" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" 
                                                 To="1.22" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" 
                                                 To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" 
                                                 To="1.0" Duration="0:0:0.15">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TribeTabBorderStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFDF78" BlurRadius="10" ShadowDepth="0" Opacity="0.95"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" 
                                                 To="1.04" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" 
                                                 To="1.04" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" 
                                                 To="1.0" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" 
                                                 To="1.0" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <!-- Холст высокого разрешения 1560x960, соответствующий фоновому арту -->
        <Canvas x:Name="CanvasRoot" Width="1560" Height="960" MouseLeftButtonDown="OnTitleBarMouseDown" Background="#01000000">
            
            <!-- Основной деревянный фон с резными рамками (чистый макет из hs3-Photoroom + аутентичные надписи) -->
            <Image x:Name="ImgWindowBg" 
                   Width="1560" Height="960" 
                   Canvas.Left="0" Canvas.Top="0" 
                   Stretch="Fill"/>

            <!-- 1. Кнопки управления окном (Свернуть / Закрыть) с точной пиксельной посадкой и подсветкой -->
            <Border Canvas.Left="1370" Canvas.Top="8" Width="119" Height="81" Cursor="Hand" Background="#01000000"
                    MouseLeftButtonDown="OnMinimizeClick"
                    MouseEnter="OnMinMouseEnter" MouseLeave="OnMinMouseLeave">
                <Image x:Name="ImgBtnMin" Width="119" Height="81" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <Border Canvas.Left="1489" Canvas.Top="0" Width="72" Height="111" Cursor="Hand" Background="#01000000"
                    MouseLeftButtonDown="OnCloseClick"
                    MouseEnter="OnCloseMouseEnter" MouseLeave="OnCloseMouseLeave">
                <Image x:Name="ImgBtnClose" Width="72" Height="111" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- 2. Кнопка фиксации / разблокировки стола справа вверху рамы -->
            <Border x:Name="BorderLockAction" Canvas.Left="1115" Canvas.Top="12" Width="260" Height="50" 
                    Background="#01000000" Cursor="Hand" 
                    PreviewMouseLeftButtonDown="OnLockCompClick"
                    MouseLeftButtonDown="OnLockCompClick"
                    ToolTip="Закрепить целевой стол до конца матча">
                <Image x:Name="ImgLockAction" Width="260" Height="50" Stretch="Uniform" IsHitTestVisible="False"/>
            </Border>

            <!-- 3. Вкладки [ТОП-1 РЕКОМЕНДАЦИЯ] [АЛЬТЕРНАТИВА 2] [АЛЬТЕРНАТИВА 3] -->
            <!-- Таб 1 -->
            <Border x:Name="Tab1Border" Canvas.Left="138" Canvas.Top="84" Width="426" Height="92"
                    Background="#01000000" Cursor="Hand" 
                    PreviewMouseLeftButtonDown="OnTab1Click"
                    MouseLeftButtonDown="OnTab1Click">
                <Image x:Name="ImgTab1" Width="426" Height="92" Stretch="Fill" IsHitTestVisible="False"/>
            </Border>

            <!-- Таб 2 -->
            <Border x:Name="Tab2Border" Canvas.Left="564" Canvas.Top="84" Width="426" Height="92"
                    Background="#01000000" Cursor="Hand" 
                    PreviewMouseLeftButtonDown="OnTab2Click"
                    MouseLeftButtonDown="OnTab2Click">
                <Image x:Name="ImgTab2" Width="426" Height="92" Stretch="Fill" IsHitTestVisible="False"/>
            </Border>

            <!-- Таб 3 -->
            <Border x:Name="Tab3Border" Canvas.Left="992" Canvas.Top="84" Width="428" Height="92"
                    Background="#01000000" Cursor="Hand" 
                    PreviewMouseLeftButtonDown="OnTab3Click"
                    MouseLeftButtonDown="OnTab3Click">
                <Image x:Name="ImgTab3" Width="428" Height="92" Stretch="Fill" IsHitTestVisible="False"/>
            </Border>

            <!-- 4. Интерактивные вкладки столов 5 активных племен лобби со спрайтами и функциональными триггерами -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="1560" Height="960">
                <!-- Слот 0: Племя 1 -->
                <Border x:Name="TribeSlot0" Canvas.Left="100" Canvas.Top="183" Width="220" Height="35" 
                        Background="#01000000" Cursor="Hand" Tag="0" Style="{StaticResource TribeTabBorderStyle}"
                        MouseLeftButtonDown="OnTribeSlotClick" MouseEnter="OnTribeSlotEnter" MouseLeave="OnTribeSlotLeave">
                    <Image x:Name="ImgTribeSlot0" Width="220" Height="35" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Слот 1: Племя 2 -->
                <Border x:Name="TribeSlot1" Canvas.Left="350" Canvas.Top="183" Width="220" Height="35" 
                        Background="#01000000" Cursor="Hand" Tag="1" Style="{StaticResource TribeTabBorderStyle}"
                        MouseLeftButtonDown="OnTribeSlotClick" MouseEnter="OnTribeSlotEnter" MouseLeave="OnTribeSlotLeave">
                    <Image x:Name="ImgTribeSlot1" Width="220" Height="35" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Слот 2: Племя 3 -->
                <Border x:Name="TribeSlot2" Canvas.Left="600" Canvas.Top="183" Width="220" Height="35" 
                        Background="#01000000" Cursor="Hand" Tag="2" Style="{StaticResource TribeTabBorderStyle}"
                        MouseLeftButtonDown="OnTribeSlotClick" MouseEnter="OnTribeSlotEnter" MouseLeave="OnTribeSlotLeave">
                    <Image x:Name="ImgTribeSlot2" Width="220" Height="35" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Слот 3: Племя 4 -->
                <Border x:Name="TribeSlot3" Canvas.Left="850" Canvas.Top="183" Width="220" Height="35" 
                        Background="#01000000" Cursor="Hand" Tag="3" Style="{StaticResource TribeTabBorderStyle}"
                        MouseLeftButtonDown="OnTribeSlotClick" MouseEnter="OnTribeSlotEnter" MouseLeave="OnTribeSlotLeave">
                    <Image x:Name="ImgTribeSlot3" Width="220" Height="35" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Слот 4: Племя 5 -->
                <Border x:Name="TribeSlot4" Canvas.Left="1100" Canvas.Top="183" Width="220" Height="35" 
                        Background="#01000000" Cursor="Hand" Tag="4" Style="{StaticResource TribeTabBorderStyle}"
                        MouseLeftButtonDown="OnTribeSlotClick" MouseEnter="OnTribeSlotEnter" MouseLeave="OnTribeSlotLeave">
                    <Image x:Name="ImgTribeSlot4" Width="220" Height="35" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </Canvas>

            <!-- 5. ОСНОВНОЙ СТОЛ: 7 НАСТОЯЩИХ КАРТ HEARTHSTONE С ЗУМОМ -->
            <ItemsControl x:Name="ItemsBoardShowcase" 
                          Canvas.Left="55" Canvas.Top="245" 
                          Width="1450" Height="375">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="195" Height="355" Margin="4,0" 
                                Background="#01000000"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource HearthstoneBoardCardStyle}"
                                ToolTipService.InitialShowDelay="150" 
                                ToolTipService.BetweenShowDelay="100">

                            <!-- Всплывающий тултип карты высокого разрешения -->
                            <Border.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0" 
                                         IsHitTestVisible="False" Placement="Top" VerticalOffset="-10">
                                    <local:CardTooltipControl DataContext="{Binding}"/>
                                </ToolTip>
                            </Border.ToolTip>
                            
                            <Grid>
                                <!-- Полная карта Blizzard с артом, описанием и тиром (или аутентичный токен для аберраций) -->
                                <Image Source="{Binding Converter={StaticResource BoardShowcaseConverter}}" 
                                       Stretch="Uniform" 
                                       Width="195" Height="340">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FFB800" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>



                                <!-- Бейдж «НА СТОЛЕ» с зеленой галочкой -->
                                <Border Visibility="{Binding Status, Converter={x:Static local:OnBoardVisibilityConverter.Instance}}"
                                        Background="#CC127A23" BorderBrush="#85FF85" BorderThickness="2" CornerRadius="12" 
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.9"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="НА СТОЛЕ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Бейдж «В РУКЕ» золотой -->
                                <Border Visibility="{Binding Status, Converter={x:Static local:InHandVisibilityConverter.Instance}}"
                                        Background="#CCA56E10" BorderBrush="#FFD700" BorderThickness="2" CornerRadius="12" 
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.9"/>
                                    </Border.Effect>
                                    <TextBlock Text="В РУКЕ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <!-- Бейдж «В ТАВЕРНЕ (ЗАМОРОЖЕН)» ледяной синий -->
                                <Border Visibility="{Binding Status, Converter={x:Static local:FrozenVisibilityConverter.Instance}}"
                                        Background="#CC165C7D" BorderBrush="#8AE2FF" BorderThickness="2" CornerRadius="12" 
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.9"/>
                                    </Border.Effect>
                                    <TextBlock Text="В ТАВЕРНЕ" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>

                                <!-- Бейдж «НУЖНО НАЙТИ» фиолетовый со звездой тира таверны -->
                                <Border Visibility="{Binding Status, Converter={x:Static local:NeedToFindVisibilityConverter.Instance}}"
                                        Background="#CC5B195B" BorderBrush="#F5A6F5" BorderThickness="2" CornerRadius="12" 
                                        Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.9"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding Tier, StringFormat='★ ТИР {0}'}" 
                                               Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 6. СЧЕТЧИКИ СОБРАННОГО И НЕДОСТАЮЩЕГО (СПРАЙТОВЫЕ ЦИФРЫ В РЕЗНЫХ ПРОМЕЖУТКАХ) -->
            <!-- Счетчик для «ЧТО СОБРАНО:» -->
            <local:SpriteNumberControl x:Name="CtrlOwnedCount" 
                                       Canvas.Left="355" Canvas.Top="673" 
                                       Width="70" Height="22" 
                                       Text="3/7" DigitHeight="22"/>

            <!-- Счетчик для «КЛЮЧЕВЫЕ КАРТЫ ДЛЯ ПОИСКА:» -->
            <local:SpriteNumberControl x:Name="CtrlMissingCount" 
                                       Canvas.Left="1355" Canvas.Top="673" 
                                       Width="70" Height="22" 
                                       Text="0" DigitHeight="22"/>


            <!-- 7. ЛЕВАЯ ПАНЕЛЬ: МИНИАТЮРЫ СОБРАННЫХ КАРТ В РАМКАХ (FRAME_ALREADY_HAVE) -->
            <ItemsControl x:Name="ItemsOwnedAvatars" 
                          Canvas.Left="88" Canvas.Top="708" 
                          Width="672" Height="150">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="94" Height="140" Margin="1,0,1,0" Background="#01000000" Cursor="Hand" ToolTipService.InitialShowDelay="150">
                            <Grid.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                                    <local:CardTooltipControl DataContext="{Binding}"/>
                                </ToolTip>
                            </Grid.ToolTip>
                            <!-- Овальный портрет карты в рамке frame_already_have -->
                            <Image Source="{Binding Converter={StaticResource OwnedFramedTokenConverter}}" 
                                   Width="94" Height="138" 
                                   Stretch="Uniform" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFB800" BlurRadius="14" ShadowDepth="0" Opacity="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Щит тира таверны в левом верхнем углу -->
                            <Border Background="#D52A142A" BorderBrush="#E5A0E5" BorderThickness="1.2" CornerRadius="6" 
                                    Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Tier, StringFormat='★{0}'}" 
                                           Foreground="#FFD9FF" FontWeight="Bold" FontSize="12" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 8. ПРАВАЯ ПАНЕЛЬ: КАРТЫ ДЛЯ ПОИСКА В РАМКАХ (FRAME_NOT_IN_HAND_YET) -->
            <ItemsControl x:Name="ItemsMissingPriorities" 
                          Canvas.Left="800" Canvas.Top="708" 
                          Width="672" Height="150">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="94" Height="140" Margin="1,0,1,0" Background="#01000000" Cursor="Hand" ToolTipService.InitialShowDelay="150">
                            <Grid.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="False">
                                    <local:CardTooltipControl DataContext="{Binding}"/>
                                </ToolTip>
                            </Grid.ToolTip>
                            <!-- Овальный портрет карты в рамке frame_not_in_hand_yet -->
                            <Image Source="{Binding Converter={StaticResource PriorityFramedTokenConverter}}" 
                                   Width="94" Height="138" 
                                   Stretch="Uniform" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGolden}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFB800" BlurRadius="14" ShadowDepth="0" Opacity="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <!-- Щит тира таверны в левом верхнем углу -->
                            <Border Background="#D52A142A" BorderBrush="#E5A0E5" BorderThickness="1.2" CornerRadius="6" 
                                    Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.8"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Tier, StringFormat='★{0}'}" 
                                           Foreground="#FFD9FF" FontWeight="Bold" FontSize="12" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 9. ФУТЕР: СПРАЙТОВЫЕ ЦИФРЫ В АУТЕНТИЧНЫХ СЛОТАХ НИЖНЕГО БАННЕРА -->
            <!-- Значение для «СРЕДНЕЕ МЕСТО:» (в слоте Window X: 781..849) -->
            <local:SpriteNumberControl x:Name="CtrlAvgPlacement" 
                                       Canvas.Left="786" Canvas.Top="904" 
                                       Width="60" Height="22" 
                                       Text="1.8" DigitHeight="22"/>

            <!-- Значение для «| ТОП-1: [значение] %» (в слоте Window X: 961..1007) -->
            <local:SpriteNumberControl x:Name="CtrlTop1Rate" 
                                       Canvas.Left="965" Canvas.Top="904" 
                                       Width="42" Height="22" 
                                       Text="44" DigitHeight="22"/>

        </Canvas>
    </Viewbox>
</Window>
